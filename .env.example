# Database Configuration (remote PostgreSQL; no database container is started by compose.yaml)
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name

# Application Configuration
PORT=3000
NODE_ENV=production

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Frontend revalidation webhook (optional; makes admin changes appear instantly)
FRONTEND_REVALIDATE_URL=https://your-portfolio-domain/api/revalidate
REVALIDATION_SECRET=change-me-to-a-long-random-string
